{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "types": ["svelte"],
    "lib": ["es2020", "dom"]
  },
  "include": ["src/**/*"]
}
